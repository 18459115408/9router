# 9Router environment contract
# This file reflects actual runtime usage in the current codebase.

# Required
JWT_SECRET=change-me-to-a-long-random-secret
INITIAL_PASSWORD=change-me
DATA_DIR=/var/lib/9router

# Recommended runtime variables
PORT=20128
NODE_ENV=production

# Recommended security and ops variables
API_KEY_SECRET=endpoint-proxy-api-key-secret
MACHINE_ID_SALT=endpoint-proxy-salt
# Leave ENABLE_REQUEST_LOGS unset: requestDetailsRepo treats ANY defined value
# (including "false") as a hard override of the dashboard Observability toggle,
# which silently disables request-detail recording. Set it to "true" only to
# enable the file-based translator logs under logs/.
# ENABLE_REQUEST_LOGS=true
OBSERVABILITY_ENABLED=true
AUTH_COOKIE_SECURE=false
REQUIRE_API_KEY=false

# Cloud sync variables
# Must point to this running instance so internal sync jobs can call /api/sync/cloud.
# Server-side preferred variables:
BASE_URL=http://localhost:20128
CLOUD_URL=https://9router.com
# Backward-compatible/public variables:
NEXT_PUBLIC_BASE_URL=http://localhost:20128
NEXT_PUBLIC_CLOUD_URL=https://9router.com

# Optional outbound proxy variables for upstream provider calls
# Lowercase variants are also supported: http_proxy, https_proxy, all_proxy, no_proxy
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
# ALL_PROXY=socks5://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1

# Baidu Netdisk DB sync (multi-instance data sync via pan.baidu.com OpenAPI)
# 1. Create an app at https://pan.baidu.com/union (personal real-name auth works).
# 2. Authorize once: open http://localhost:20127/api/sync/baidu/authorize while logged
#    into the dashboard, then paste the shown code into /api/sync/baidu/exchange?code=...
# 3. Tokens live in <DATA_DIR>/baidu-sync/token.json (refresh_token is single-use and
#    rotated on every refresh — never copy token.json between machines).
BAIDU_APP_KEY=
BAIDU_SECRET_KEY=
# AppKey signing key (kept for future signed-request APIs; unused by the sync flow)
BAIDU_SIGN_KEY=
# Product name chosen at app creation — defines the netdisk dir /apps/{BAIDU_APP_NAME}/
BAIDU_APP_NAME=9router
# AES-256-GCM passphrase for the uploaded DB snapshot. MUST be identical on every
# syncing instance. Rotating it makes the existing cloud blob undecryptable.
BAIDU_SYNC_KEY=
# Optional overrides (defaults shown)
# BAIDU_SYNC_INTERVAL_MINUTES=30
# BAIDU_SYNC=on
# BAIDU_REMOTE_DIR=/apps/9router/9router-sync
# Comma-separated tables that stay machine-local (never uploaded/overwritten).
# Defaults: requestDetails,apiKeys (the apiKeys feature is slated for removal).
# BAIDU_SYNC_EXCLUDE_TABLES=requestDetails,apiKeys
# Only set if you registered a redirect URI in the app console; otherwise oob is used.
# BAIDU_REDIRECT_URI=http://127.0.0.1:20127/api/sync/baidu/callback

# Optional SearXNG endpoint for the built-in unauthenticated web-search provider.
# SEARXNG_URL=http://searxng:8080/search

# Currently unused by application runtime (kept as reference)
# INSTANCE_NAME=9router
